# Provider API Keys (leave empty to use the built-in darkroom mock fallback)
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
REPLICATE_API_TOKEN=

# Database Connection
DATABASE_URL=sqlite:///./aperture.db

# Frontend Web App Origin
ALLOWED_ORIGIN=http://localhost:3000

# Session Secret (for cookie signature)
SESSION_SECRET=darkroom_aperture_monochrome_secret_key_2026

# Fallback to Mock Provider when API keys are missing (great for local test/dev)
ALLOW_MOCK_FALLBACK=true
